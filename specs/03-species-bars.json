{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Distinct occurrence records by species, 2016-2025. Species groups include named subspecies.",
  "width": "container",
  "height": 235,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 8,
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#607176",
      "titleColor": "#607176",
      "domain": false,
      "ticks": false,
      "gridColor": "#e9eeea",
      "gridOpacity": 1,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#435c62",
      "titleColor": "#435c62",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolSize": 65
    },
    "title": {
      "font": "DM Sans",
      "color": "#173c43"
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  },
  "data": {
    "url": "data/observations.json"
  },
  "transform": [
    {
      "filter": "datum.year <= 2025"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "records"
        }
      ],
      "groupby": [
        "species"
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "species",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelLimit": 155
      }
    },
    "x": {
      "field": "records",
      "type": "quantitative",
      "axis": {
        "title": "Observation records",
        "tickCount": 4
      },
      "scale": {
        "zero": true
      }
    },
    "color": {
      "field": "species",
      "type": "nominal",
      "scale": {
        "domain": [
          "Humpback whale",
          "Southern right whale",
          "Sperm whale",
          "Blue whale"
        ],
        "range": [
          "#167b80",
          "#d28b50",
          "#8b76a5",
          "#467bb1"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 24,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "tooltip": [
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "records",
            "title": "Records (2016–2025)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "color": "#173c43"
      },
      "encoding": {
        "text": {
          "field": "records",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ]
}
