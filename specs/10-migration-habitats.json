{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Categorical area map of DCCEEW Biologically Important Areas, coloured by habitat use. Select a whale category and hover over a mapped area for its source information. These are habitat boundaries, not protected areas or complete species ranges.",
  "width": "container",
  "height": 410,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 8,
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#607176",
      "titleColor": "#607176",
      "domain": false,
      "ticks": false,
      "gridColor": "#e9eeea",
      "gridOpacity": 1,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#435c62",
      "titleColor": "#435c62",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolSize": 65
    },
    "title": {
      "font": "DM Sans",
      "color": "#173c43"
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  },
  "params": [
    {
      "name": "habitatSpecies",
      "value": "Humpback Whale"
    }
  ],
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) === 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e8e5db",
        "stroke": "#b7c6c7",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/whale-habitats.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.COMMON_NAME === habitatSpecies"
        }
      ],
      "mark": {
        "type": "geoshape",
        "opacity": 0.55,
        "stroke": "#5b9294",
        "strokeWidth": 0.45,
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "properties.BEHAVIOUR_CAT",
          "type": "nominal",
          "scale": {
            "domain": [
              "Migration",
              "Foraging",
              "Resting",
              "Reproduction"
            ],
            "range": [
              "#719eb6",
              "#7eb8a1",
              "#d4b66c",
              "#c98d93"
            ]
          },
          "legend": {
            "title": "Habitat use",
            "columns": 2,
            "titleLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "properties.COMMON_NAME",
            "title": "Species"
          },
          {
            "field": "properties.BEHAVIOUR_CAT",
            "title": "BIA use"
          },
          {
            "field": "properties.LOCATION",
            "title": "Area"
          },
          {
            "field": "properties.SEASON",
            "title": "Seasonal note"
          },
          {
            "field": "properties.OBJECTID",
            "title": "BIA ID"
          }
        ]
      }
    }
  ]
}
