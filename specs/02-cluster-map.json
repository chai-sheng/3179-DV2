{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional circle areas show record totals in fixed one-degree geographic cells, not population density. Same map controls as chart 01.",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 8,
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#607176",
      "titleColor": "#607176",
      "domain": false,
      "ticks": false,
      "gridColor": "#e9eeea",
      "gridOpacity": 1,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#435c62",
      "titleColor": "#435c62",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolSize": 65
    },
    "title": {
      "font": "DM Sans",
      "color": "#173c43"
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  },
  "params": [
    {
      "name": "speciesChoice",
      "value": "All"
    },
    {
      "name": "yearChoice",
      "value": "all"
    },
    {
      "name": "seasonChoice",
      "value": "All"
    }
  ],
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) === 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e8e5db",
        "stroke": "#b7c6c7",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/observations.json"
      },
      "transform": [
        {
          "filter": "(yearChoice === 'all' ? datum.year <= 2025 : datum.year === toNumber(yearChoice)) && (speciesChoice === 'All' || datum.species === speciesChoice) && (seasonChoice === 'All' || (seasonChoice === 'summer' && (datum.month===12 || datum.month<=2)) || (seasonChoice === 'autumn' && datum.month>=3 && datum.month<=5) || (seasonChoice === 'winter' && datum.month>=6 && datum.month<=8) || (seasonChoice === 'spring' && datum.month>=9 && datum.month<=11))"
        },
        {
          "calculate": "floor(datum.lon)+0.5",
          "as": "cell_lon"
        },
        {
          "calculate": "floor(datum.lat)+0.5",
          "as": "cell_lat"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "records"
            }
          ],
          "groupby": [
            "cell_lon",
            "cell_lat"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#167b80",
        "fillOpacity": 0.28,
        "stroke": "#167b80",
        "strokeWidth": 1,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "cell_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cell_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "records",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ],
            "range": [
              0,
              1500
            ],
            "zero": true
          },
          "legend": {
            "title": "Records per 1° cell",
            "values": [
              10,
              50,
              100,
              300
            ]
          }
        },
        "tooltip": [
          {
            "field": "records",
            "title": "Observation records"
          },
          {
            "field": "cell_lon",
            "title": "Cell centre °E"
          },
          {
            "field": "cell_lat",
            "title": "Cell centre latitude"
          }
        ]
      }
    }
  ]
}
