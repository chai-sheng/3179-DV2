{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Treemap nested by year then species. Precomputed balanced split layout preserves area proportional to counts. Rectangles describe evidence composition, not habitat size.",
  "width": "container",
  "height": 310,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 8,
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#607176",
      "titleColor": "#607176",
      "domain": false,
      "ticks": false,
      "gridColor": "#e9eeea",
      "gridOpacity": 1,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#435c62",
      "titleColor": "#435c62",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolSize": 65
    },
    "title": {
      "font": "DM Sans",
      "color": "#173c43"
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/treemap-leaves.json"
      },
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 0.6
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              62
            ],
            "reverse": true
          }
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Humpback whale",
              "Southern right whale",
              "Sperm whale",
              "Blue whale"
            ],
            "range": [
              "#167b80",
              "#d28b50",
              "#8b76a5",
              "#467bb1"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "count",
            "title": "Records"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/treemap-years.json"
      },
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#fff",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              62
            ],
            "reverse": true
          }
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "data": {
        "url": "data/treemap-years.json"
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "white",
        "stroke": "#173c43",
        "strokeWidth": 0.25
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              62
            ],
            "reverse": true
          }
        },
        "text": {
          "field": "year",
          "type": "ordinal"
        }
      }
    }
  ]
}
