{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Seasonal habitat map of six selected DCCEEW records. Choose a month to highlight areas whose documented seasonal windows include that month. Colours identify whale categories, not abundance.",
  "width": "container",
  "height": 410,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 8,
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#607176",
      "titleColor": "#607176",
      "domain": false,
      "ticks": false,
      "gridColor": "#e9eeea",
      "gridOpacity": 1,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#435c62",
      "titleColor": "#435c62",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolSize": 65
    },
    "title": {
      "font": "DM Sans",
      "color": "#173c43"
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  },
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "params": [
    {
      "name": "seasonMonth",
      "value": "all"
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) === 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e8e5db",
        "stroke": "#b7c6c7",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/whale-habitats.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.OBJECTID",
          "from": {
            "data": {
              "url": "data/seasons.json"
            },
            "key": "id",
            "fields": [
              "place",
              "species",
              "first_month",
              "last_month",
              "meaning",
              "source_note"
            ]
          }
        },
        {
          "filter": "isValid(datum.first_month)"
        },
        {
          "calculate": "['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][datum.first_month-1] + '–' + ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][datum.last_month-1]",
          "as": "window"
        },
        {
          "filter": "seasonMonth === 'all' || (toNumber(seasonMonth) >= datum.first_month && toNumber(seasonMonth) <= datum.last_month)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "opacity": 0.55,
        "stroke": "#315c64",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Humpback whale",
              "Southern right whale",
              "Blue whale"
            ],
            "range": [
              "#167b80",
              "#d28b50",
              "#467bb1"
            ]
          },
          "legend": {
            "title": "Whale category",
            "columns": 1,
            "labelLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "place",
            "title": "Area / use"
          },
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "window",
            "title": "Documented window"
          },
          {
            "field": "meaning",
            "title": "What this window means"
          },
          {
            "field": "source_note",
            "title": "Source note"
          },
          {
            "field": "properties.OBJECTID",
            "title": "BIA ID"
          }
        ]
      }
    }
  ]
}
