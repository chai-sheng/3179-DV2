{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual submission records, 2016-2025. The 321 partial-2026 records are excluded. This is not a tourism or whale-population time series.",
  "width": "container",
  "height": 260,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 8,
  "config": {
    "background": "transparent",
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "labelColor": "#607176",
      "titleColor": "#607176",
      "domain": false,
      "ticks": false,
      "gridColor": "#e9eeea",
      "gridOpacity": 1,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#435c62",
      "titleColor": "#435c62",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolSize": 65
    },
    "title": {
      "font": "DM Sans",
      "color": "#173c43"
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  },
  "data": {
    "url": "data/observations.json"
  },
  "transform": [
    {
      "filter": "datum.year <= 2025"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "records"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": "ascending",
      "axis": {
        "title": null,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "records",
      "type": "quantitative",
      "scale": {
        "zero": true
      },
      "axis": {
        "title": "Observation records",
        "tickCount": 5
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Calendar year"
      },
      {
        "field": "records",
        "title": "Records"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#e7eff1",
        "opacity": 0.8
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#356f85",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 42
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2025"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "color": "#173c43",
        "fontWeight": "bold",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "records",
          "type": "quantitative"
        }
      }
    }
  ]
}
